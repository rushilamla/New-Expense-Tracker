# Backend configuration
NODE_ENV=development
PORT=5000

# MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/expense_tracker"

# Auth
JWT_SECRET="replace_with_strong_secret"
JWT_EXPIRES_IN=7d

# CORS (set to your frontend origin(s))
# Example (local): http://localhost:5173
# Example (prod): https://your-frontend-domain.com
CORS_ORIGIN="http://localhost:5173"

# Cookie settings for cross-site (frontend domain != backend domain)
# Use "none" + Secure=true in production.
COOKIE_SAMESITE="none"

