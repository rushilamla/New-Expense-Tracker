NODE_ENV=development
PORT=5000

# Docker MySQL (matches docker-compose.yml)
DATABASE_URL="mysql://appuser:apppassword@localhost:3306/expense_tracker"

JWT_SECRET="replace_with_strong_secret"
JWT_EXPIRES_IN=7d

# Frontend origin on your machine (Vite default)
CORS_ORIGIN="http://localhost:5173"

# Cross-site cookies for separate frontend/backend origins
# If you hit cookie issues, try switching COOKIE_SAMESITE to `lax` temporarily.
COOKIE_SAMESITE="none"

# Use this in Docker deployments to auto-run migrations.
#RUN_MIGRATIONS=true

